bool Gates(string &why)
  {
   datetime now=TimeCurrent();
   if(DayStart(now)!=g_day){ g_day=DayStart(now); g_dayStartBalance=Bal(); g_dayPnL=0; g_dayBaskets=0; g_dayStopped=false; }
   if(g_dayStopped){ why="day stopped"; return false; }
   if(InpMaxDailyLossPct>0 && g_dayStartBalance>0 && g_dayPnL<=-g_dayStartBalance*InpMaxDailyLossPct/100.0){ g_dayStopped=true; why="daily loss limit"; return false; }
   if(InpDailyProfitLock>0 && g_dayPnL>=g_dayStartBalance*InpDailyProfitLock/100.0){ g_dayStopped=true; why="daily profit locked"; return false; }
   if(InpMaxBasketsPerDay>0 && g_dayBaskets>=InpMaxBasketsPerDay){ why="max baskets today"; return false; }
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)||!MQLInfoInteger(MQL_TRADE_ALLOWED)){ why="AutoTrading off"; return false; }
   if(SymbolInfoInteger(_Symbol,SYMBOL_TRADE_MODE)!=SYMBOL_TRADE_MODE_FULL){ why="market closed / restricted"; return false; }
   if(InpMaxSpreadATR>0 && atr>0)
     { Sym.RefreshRates(); if(Sym.Ask()-Sym.Bid()>InpMaxSpreadATR*atr){ why="spread too wide"; return false; } }
   string vw;
   if(!InpIgnoreViabilityCheck && !ViabilityCheck(vw)){ why=vw; return false; }
   return true;
  }

bool OpenCampaign(int dir)
  {
   string why;
   if(!Gates(why)){ g_note=why; g_blocked=true; return false; }
   g_blocked=false;
   return g_layered?OpenLayer1(dir):OpenBase(dir);
  }

void TryEntry()
  {
   if(BasketCount()>0) return;
   if(InpReentryCooldownSec>0 && (TimeCurrent()-g_lastExitTime)<InpReentryCooldownSec){ g_note="re-entry cooldown"; return; }
   int d=EntryDirection(false);
   if(d==0){ if(g_confDir==0) g_note="no direction yet"; return; }
   g_note="entering "+DirStr(d);
   OpenCampaign(d);
  }

void ManageBasket()
  {
   if(BasketCount()==0){ if(g_dir!=0) ResetCampaign(); return; }
   if(g_dir==0) g_dir=BasketDir();

   double profit=BasketProfit(),bal=Bal();
   bool fixedMode=(InpUseFixedTPSL && g_layered);

   // in fixed mode the broker-side TP and staged trailing SL replace the money target / profit lock
   if(!fixedMode)
     {
      double target=(InpTargetMode==TGT_PCT_BALANCE)?bal*InpTargetPct/100.0:InpTargetCash;
      if(profit>=target){ CloseBasket(StringFormat("target +%.2f",profit)); return; }
     }
   if(profit<=-StopCash()){ CloseBasket(StringFormat("basket stop %.2f",profit)); return; }

   if(!fixedMode)
     {
      g_peakBasket=MathMax(g_peakBasket,profit);
      if(g_peakBasket>=bal*InpTrailStartPct/100.0) g_locked=true;
      if(g_locked && profit<=bal*InpTrailLockPct/100.0){ CloseBasket(StringFormat("profit lock +%.2f",profit)); return; }
     }

   // flip with the market - stop and reverse on the same tick
   if(InpFlipOnReverse && g_confDir!=0 && g_confDir!=g_dir)
     {
      int nd=g_confDir;
      CloseBasket(StringFormat("flip %s -> %s",DirStr(g_dir),DirStr(nd)));
      if(InpStopAndReverse && BasketCount()==0)
        {
         int d=EntryDirection(true);
         if(d==nd){ g_note="reversed to "+DirStr(nd); OpenCampaign(nd); }
        }
     }
  }

void OnNewBar()
  {
   if(BasketCount()>0)
     {
      g_barsHeld++;
      if(InpMaxHoldBars>0 && g_barsHeld>=InpMaxHoldBars && BasketProfit()<0) CloseBasket("time exit");
      return;
     }
   if(!InpIntrabarEntry) TryEntry();
  }

// rebuild tracking after a restart / recompile with positions open
void RecoverState()
  {
   ulong tk[]; long tm[]; int n=0;
   for(int i=PositionsTotal()-1;i>=0;i--)
      if(Pos.SelectByIndex(i)&&Mine())
        { ArrayResize(tk,n+1); ArrayResize(tm,n+1); tk[n]=Pos.Ticket(); tm[n]=(long)PositionGetInteger(POSITION_TIME_MSC); n++; }
   if(n==0) return;
   for(int a=0;a<n-1;a++) for(int b=0;b<n-1-a;b++)
      if(tm[b]>tm[b+1]){ long t=tm[b]; tm[b]=tm[b+1]; tm[b+1]=t; ulong k=tk[b]; tk[b]=tk[b+1]; tk[b+1]=k; }
   g_dir=BasketDir(); g_adds=n-1;
   if(PositionSelectByTicket(tk[0])) g_baseLot=PositionGetDouble(POSITION_VOLUME);
   if(PositionSelectByTicket(tk[n-1])) g_lastEntry=PositionGetDouble(POSITION_PRICE_OPEN);
   if(g_layered)
     {
      g_nPos=(int)MathMin(n,MAX_POS); g_nLayers=1;
      for(int j=0;j<g_nPos;j++)
         if(PositionSelectByTicket(tk[j]))
           {
            g_pTicket[j]=tk[j]; g_pEntry[j]=PositionGetDouble(POSITION_PRICE_OPEN); g_pSL[j]=PositionGetDouble(POSITION_SL); g_pLots[j]=PositionGetDouble(POSITION_VOLUME);
            string c=PositionGetString(POSITION_COMMENT);
            int ly=1; if(StringFind(c,"pyrL")==0) ly=(int)MathMax(1,StringToInteger(StringSubstr(c,4)));
            g_pLayer[j]=ly; if(ly>g_nLayers) g_nLayers=ly;
           }
      g_adds=g_nLayers-1;
      if(InpUseFixedTPSL)
        {
         g_tpDist=PipDist(InpTPPips);
         g_tpPrice=0; if(PositionSelectByTicket(tk[0])) g_tpPrice=PositionGetDouble(POSITION_TP);
         if(g_tpPrice<=0){ g_entry0=g_pEntry[0]; g_tpPrice=Nrm(g_entry0+g_dir*g_tpDist); }
         else g_entry0=Nrm(g_tpPrice-g_dir*g_tpDist);          // campaign entry derived from the shared TP
         g_campaignR=PipDist(SLPips());
         g_campaignSLPrice=Nrm(g_entry0-g_dir*g_campaignR);
         g_trailSL=0; g_trailStage=-1;
         if(g_pSL[0]>0 && g_dir*(g_pSL[0]-g_campaignSLPrice)>_Point) g_trailSL=g_pSL[0];
        }
      else
        {
         g_entry0=g_pEntry[0];
         double r=InpInitialStopATR*atr;
         g_campaignSLPrice=(g_pSL[g_nPos-1]>0)?g_pSL[g_nPos-1]:g_pEntry[0]-g_dir*r;
         g_campaignR=(r>0)?r:MathAbs(g_pEntry[0]-g_campaignSLPrice);
        }
     }
   LG("RECOVER",StringFormat("resumed %s basket: %d position(s), %d layer(s), %.2f lots",DirStr(g_dir),n,g_nLayers,BasketLots()));
  }

