//| Layered risk pyramid                                             |
//+------------------------------------------------------------------+
// lots for ONE position: the layer risk is split equally between the positions of the layer
double PosLots(double dist)
  {
   double mpl=MoneyPerLotPerPrice();
   if(dist<=0||mpl<=0) return NormLot(MinLot());
   return NormLot(Bal()*InpLayerRiskPct/100.0/PosPerLayer()/(dist*mpl));
  }
int NumLayersAllowed()
  {
   int n=(InpLayerRiskPct>0)?(int)MathFloor(InpTotalRiskPct/InpLayerRiskPct+1e-6):1;
   return (int)MathMax(1,MathMin(n,MathMin(InpMaxLayers,MAX_LAYERS)));
  }
// fixed mode: % of TP distance at which the NEXT layer opens (nOpen = layers already open)
double LayerTriggerPct(int nOpen)
  {
   if(nOpen<=1) return InpLayer2TriggerPct;   // 20%
   if(nOpen==2) return InpLayer3TriggerPct;   // 35%
   if(nOpen==3) return InpLayer4TriggerPct;   // 50%
   if(nOpen==4) return InpLayer5TriggerPct;   // 65%
   return InpLayer6TriggerPct;                // 80%
  }
double LayerTriggerR(int nOpen)
  {
   if(nOpen<=1) return InpLayer2TriggerR;
   if(nOpen==2) return InpLayer3TriggerR;
   return InpLayer4TriggerR+(nOpen-3)*(InpLayer4TriggerR-InpLayer3TriggerR);
  }

// drop tracked positions that no longer exist (closed by SL / TP / breakeven)
void SyncLayers()
  {
   if(g_nPos==0) return;
   int w=0;
   for(int j=0;j<g_nPos;j++)
      if(g_pTicket[j]>0 && PositionSelectByTicket(g_pTicket[j]))
        {
         if(w!=j){ g_pTicket[w]=g_pTicket[j]; g_pEntry[w]=g_pEntry[j]; g_pSL[w]=g_pSL[j]; g_pLots[w]=g_pLots[j]; g_pLayer[w]=g_pLayer[j]; }
         w++;
        }
   if(w!=g_nPos)
     {
      LG("SYNC",StringFormat("%d position(s) closed by broker - %d remain",g_nPos-w,w));
      g_nPos=w;
      if(w==0 && BasketCount()==0){ ResetCampaign(); g_lastExitTime=TimeCurrent(); }
     }
  }

// true only when EVERY open position is at breakeven or better (used as the gate before a new layer)
bool ProtectEarlierLayers()
  {
   double buf=InpBreakevenBufferATR*atr,md=StopsDist();
   Sym.RefreshRates();
   bool all=true;
   for(int j=0;j<g_nPos;j++)
     {
      double be=Nrm(g_pEntry[j]+g_dir*buf);
      bool atBE=(g_pSL[j]>0) && ((g_dir>0)?(g_pSL[j]>=be-_Point):(g_pSL[j]<=be+_Point));
      if(atBE) continue;
      bool placeable=(g_dir>0)?(be<=Sym.Bid()-md):(be>=Sym.Ask()+md);
      if(placeable && g_pTicket[j]>0 && Trade.PositionModify(g_pTicket[j],be,g_tpPrice))   // keep TP!
        { g_pSL[j]=be; LG("PROTECT",StringFormat("layer %d pos #%I64u SL -> %s (BE+buf)",g_pLayer[j],g_pTicket[j],DoubleToString(be,_Digits))); }
      else all=false;
     }
   return all;
  }

// PER-POSITION BREAKEVEN: a position that is > InpBEMovePct of the TP distance in profit gets SL = its own entry (+buffer)
void ApplyBreakevenRule()
  {
   if(!InpUseBEMove || !InpUseFixedTPSL) return;
   if(g_nPos==0 || g_dir==0 || g_tpDist<=0) return;
   Sym.RefreshRates();
   double px=(g_dir>0)?Sym.Bid():Sym.Ask();
   double trig=InpBEMovePct/100.0*g_tpDist;
   double buf=InpBreakevenBufferATR*atr,md=StopsDist();
   for(int j=0;j<g_nPos;j++)
     {
      if(g_pTicket[j]==0) continue;
      if(g_dir*(px-g_pEntry[j])<trig-1e-9) continue;               // not far enough in profit yet
      double be=Nrm(g_pEntry[j]+g_dir*buf);
      if(g_pSL[j]>0 && g_dir*(be-g_pSL[j])<=_Point) continue;      // SL already at / beyond breakeven
      bool placeable=(g_dir>0)?(be<=Sym.Bid()-md):(be>=Sym.Ask()+md);
      if(!placeable) continue;
      if(Trade.PositionModify(g_pTicket[j],be,g_tpPrice))
        { g_pSL[j]=be; LG("BE",StringFormat("layer %d pos #%I64u > %.0f%% TP in profit -> SL to breakeven %s",g_pLayer[j],g_pTicket[j],InpBEMovePct,DoubleToString(be,_Digits))); }
     }
  }

// STAGED TRAILING: SL follows % of TP reached (see TRAIL_AT / TRAIL_TO). Only moves forward.
void ApplyStagedTrail()
  {
   if(!InpUseFixedTPSL || !InpUseStagedTrail) return;
   if(g_nPos==0 || g_dir==0 || g_tpDist<=0 || g_entry0<=0) return;
   Sym.RefreshRates();
   double px=(g_dir>0)?Sym.Bid():Sym.Ask();
   double prog=g_dir*(px-g_entry0)/g_tpDist;          // 0.20 = 20% of TP reached

   int st=-1;
   for(int i=0;i<TRAIL_STAGES;i++) if(prog>=TRAIL_AT[i]-1e-9) st=i;

   double md=StopsDist();
   if(st>=0)
     {
      double lvl=Nrm(g_entry0+g_dir*TRAIL_TO[st]*g_tpDist);
      bool ok=(g_dir>0)?(lvl<=Sym.Bid()-md):(lvl>=Sym.Ask()+md);
      if(ok && (g_trailSL==0 || g_dir*(lvl-g_trailSL)>_Point))
        {
         g_trailSL=lvl; g_trailStage=st;
         LG("TRAIL",StringFormat("crossed %.0f%% TP -> SL to %.0f%% TP = %s",TRAIL_AT[st]*100,TRAIL_TO[st]*100,DoubleToString(lvl,_Digits)));
        }
     }
   if(g_trailSL<=0) return;

   // push the trailed SL onto every position that is still behind it (also retries failed modifies)
   for(int j=0;j<g_nPos;j++)
     {
      if(g_pTicket[j]==0) continue;
      if(g_pSL[j]>0 && g_dir*(g_trailSL-g_pSL[j])<=_Point) continue;
      bool placeable=(g_dir>0)?(g_trailSL<=Sym.Bid()-md):(g_trailSL>=Sym.Ask()+md);
      if(!placeable) continue;
      if(Trade.PositionModify(g_pTicket[j],g_trailSL,g_tpPrice)) g_pSL[j]=g_trailSL;
     }
  }

bool OpenLayer1(int dir)
  {
   Sym.RefreshRates();
   int N=PosPerLayer();
   double spread=Sym.Ask()-Sym.Bid();
   double baseDist=InpUseFixedTPSL?PipDist(SLPips()):InpInitialStopATR*atr;
   double stopDist=MathMax(baseDist,StopsDist()+spread);
   double tpDist=InpUseFixedTPSL?PipDist(InpTPPips):0;
   double lots=PosLots(stopDist);
   int n=N;
   if(InpMaxTotalLots>0)
     {
      n=(int)MathMin(N,MathFloor(InpMaxTotalLots/lots+1e-9));
      if(n<1){ g_note="lot cap too small for one position"; return false; }
     }
   if(!MarginOK(dir,lots*n)){ g_note="not enough free margin"; return false; }
   double est=(dir>0)?Sym.Ask():Sym.Bid();
   double tpPrice=(tpDist>0)?Nrm(est+dir*tpDist):0;

   g_nPos=0;
   int opened=0; double firstFill=0,firstSL=0;
   for(int k=0;k<n;k++)
     {
      double fill; ulong tk;
      if(!SendMarket(dir,lots,SafeSL(dir,est-dir*stopDist),tpPrice,fill,tk,"pyrL1")) break;
      double sl=EnsureSL(tk,dir,fill-dir*stopDist,tpPrice);
      if(sl<=0) sl=fill-dir*stopDist;
      AddPos(tk,fill,sl,lots,1);
      opened++;
      if(opened==1){ firstFill=fill; firstSL=sl; }
     }
   if(opened==0) return false;

   g_nLayers=1;
   g_campaignR=MathAbs(firstFill-firstSL); g_campaignSLPrice=firstSL;
   g_entry0=firstFill; g_tpPrice=tpPrice; g_tpDist=tpDist; g_trailSL=0; g_trailStage=-1;
   g_dir=dir; g_adds=0; g_lastEntry=firstFill; g_baseLot=lots; g_barsHeld=0; g_peakBasket=0; g_locked=false; g_dayBaskets++;
   double riskPct=(Bal()>0)?lots*opened*MoneyPerLotPerPrice()*g_campaignR/Bal()*100.0:0;
   LG("LAYER1",StringFormat("%s %d x %.2f @ %s SL %s TP %s R=%s layer risk %.2f%% (plan %.2f%%, %d layers / %.1f%%)",
        DirStr(dir),opened,lots,DoubleToString(firstFill,_Digits),DoubleToString(firstSL,_Digits),tpPrice>0?DoubleToString(tpPrice,_Digits):"-",
        DoubleToString(g_campaignR,_Digits),riskPct,InpLayerRiskPct,NumLayersAllowed(),InpTotalRiskPct));
   if(opened<N) LG("WARN",StringFormat("only %d of %d positions opened for layer 1",opened,N));
   if(riskPct>InpLayerRiskPct*2) LG("WARN","min lot x positions forces layer risk above plan - balance is small for this SL distance");
   return true;
  }

bool OpenLayer(int dir)
  {
   if(g_nLayers>=MAX_LAYERS) return false;
   int N=PosPerLayer();
   if(g_nPos+N>MAX_POS){ g_note="position array full"; return false; }
   Sym.RefreshRates();
   double spread=Sym.Ask()-Sym.Bid();
   double entry=(dir>0)?Sym.Ask():Sym.Bid();
   double riskDist=dir*(entry-g_campaignSLPrice);      // sized on the ORIGINAL campaign SL, so risk never exceeds plan
   if(riskDist<StopsDist()+spread){ g_note="too close to campaign SL to add"; return false; }
   if(g_tpPrice>0 && dir*(g_tpPrice-entry)<StopsDist()+spread){ g_note="too close to TP to add a layer"; return false; }
   double lots=PosLots(riskDist);
   int n=N;
   if(InpMaxTotalLots>0)
     {
      double room=InpMaxTotalLots-BasketLots();
      n=(int)MathMin(N,MathFloor(room/lots+1e-9));
      if(n<1){ g_note="lot cap reached"; return false; }
     }
   if(!MarginOK(dir,lots*n)){ g_note="not enough free margin to add"; return false; }

   // use the trailed SL for the new layer if it is already active and valid
   double wantSL=g_campaignSLPrice,md=StopsDist();
   if(g_trailSL>0 && dir*(g_trailSL-wantSL)>0)
     {
      bool okT=(dir>0)?(g_trailSL<=Sym.Bid()-md):(g_trailSL>=Sym.Ask()+md);
      if(okT) wantSL=g_trailSL;
     }
   int layerNo=g_nLayers+1;
   string cmt="pyrL"+IntegerToString(layerNo);
   int opened=0; double firstFill=0,firstSL=0;
   for(int k=0;k<n;k++)
     {
      double fill; ulong tk;
      if(!SendMarket(dir,lots,SafeSL(dir,wantSL),g_tpPrice,fill,tk,cmt)) break;
      double sl=EnsureSL(tk,dir,wantSL,g_tpPrice); if(sl<=0) sl=wantSL;
      AddPos(tk,fill,sl,lots,layerNo);
      opened++;
      if(opened==1){ firstFill=fill; firstSL=sl; }
     }
   if(opened==0) return false;
   g_nLayers=layerNo; g_adds=g_nLayers-1; g_lastEntry=firstFill;
   LG("LAYER",StringFormat("#%d %s %d x %.2f @ %s SL %s TP %s basket %.2f lots",g_nLayers,DirStr(dir),opened,lots,DoubleToString(firstFill,_Digits),DoubleToString(firstSL,_Digits),
        g_tpPrice>0?DoubleToString(g_tpPrice,_Digits):"-",BasketLots()));
   if(opened<N) LG("WARN",StringFormat("only %d of %d positions opened for layer %d",opened,N,layerNo));
   return true;
  }

void TryLayeredPyramid()
  {
   if(g_nLayers==0||g_dir==0) return;
   if(g_nLayers>=NumLayersAllowed()){ g_note="all layers filled"; return; }
   if(InpAddOnlyInProfit && BasketProfit()<=0) return;
   double R=g_campaignR; if(R<=0) return;
   Sym.RefreshRates();
   double px=(g_dir>0)?Sym.Bid():Sym.Ask();
   bool fx=(InpUseFixedTPSL && g_tpDist>0 && g_entry0>0);
   double unit=fx?g_tpDist:R, basePx=g_entry0;
   double need=fx?LayerTriggerPct(g_nLayers)/100.0:LayerTriggerR(g_nLayers);
   double prog=g_dir*(px-basePx)/unit;
   if(prog<need)
     {
      g_note=fx?StringFormat("layer %d needs %.0f%% of TP (at %.0f%%)",g_nLayers+1,need*100,prog*100)
               :StringFormat("layer %d needs +%.2fR (at %.2fR)",g_nLayers+1,need,prog);
      return;
     }
   if(InpRequireConfirmClose)
     {
      double trig=basePx+g_dir*need*unit, lc=iClose(_Symbol,InpTF,1);
      if(!((g_dir>0)?(lc>=trig):(lc<=trig))){ g_note=StringFormat("layer %d: waiting for close past %s",g_nLayers+1,DoubleToString(trig,_Digits)); return; }
     }
   if(g_confDir!=g_dir){ g_note=StringFormat("layer %d: trend not confirming",g_nLayers+1); return; }
   if(!ProtectEarlierLayers()){ g_note="waiting for earlier positions to reach breakeven"; return; }
   OpenLayer(g_dir);
  }

