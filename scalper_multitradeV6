//+------------------------------------------------------------------+
//|                                  XAUUSD_PyramidScalper_v4.mq5    |
//|                                                                  |
//|  v4.03 - 6-LAYER PYRAMID, 5 POSITIONS PER LAYER, 24/7            |
//|   * SL = 200 pips, TP = 500 pips (broker-side, shared TP).       |
//|   * Up to 6 layers. Layer 2 opens at 20% of TP, then layers      |
//|     3..6 at 35% / 50% / 65% / 80% of TP.                         |
//|   * NEW: every layer opens InpPositionsPerLayer (default 5)      |
//|     separate positions. The layer risk (InpLayerRiskPct) is      |
//|     split equally between them.                                  |
//|   * NEW: per-position breakeven rule. When a position has moved  |
//|     more than InpBEMovePct (20%) of the TP distance in profit,   |
//|     its SL is moved to its own breakeven (+ buffer).             |
//|   * Staged trailing SL (% of TP from campaign entry):            |
//|        30% TP -> SL 10% | 50% -> 35% | 80% -> 60%                |
//|        90% TP -> SL 80% | 100% -> 90%                            |
//|     The SL only ever moves FORWARD (never loosens).              |
//|   * Before a new layer opens, all earlier positions are moved    |
//|     to breakeven. New layers use the trailed SL if active.       |
//|   * Each layer is sized on the ORIGINAL campaign SL.             |
//|   * In fixed mode the % balance target and profit-lock are off.  |
//|     Basket money stop and stop-and-reverse flips still work.     |
//|   * Session filter REMOVED: the bot trades 24/7.                 |
//+------------------------------------------------------------------+
#property copyright "XAUUSD Pyramid Scalper"
#property version   "4.03"
#property description "Pyramiding scalper: 6 layers x 5 positions, fixed TP/SL, BE at 20% TP, staged trail, 24/7"

#include <Trade\Trade.mqh>
#include <Trade\PositionInfo.mqh>
#include <Trade\SymbolInfo.mqh>

enum ENUM_TARGET_MODE  { TGT_PCT_BALANCE, TGT_FIXED_CASH };
enum ENUM_TREND_FILTER { TFILT_OFF=0, TFILT_ENTRY_ONLY=1, TFILT_STRICT=2 };

//+------------------------------------------------------------------+
input group "=== Fixed TP / SL + staged trailing ==="
input bool   InpUseFixedTPSL     = true;      // true = fixed pip TP/SL (layered mode / hedging accounts)
input double InpTPPips           = 500.0;     // take profit, pips (500 pips = $50.00 on 2-digit gold)
input bool   InpSLEqualsTP       = false;     // true = SL pips = TP pips; false = use InpSLPips
input double InpSLPips           = 200.0;     // SL pips (200 pips = $20.00) - used when InpSLEqualsTP = false
input double InpLayer2TriggerPct = 20.0;      // fixed mode: open layer 2 when price is N% of TP in profit
input double InpLayer3TriggerPct = 35.0;      // ... layer 3
input double InpLayer4TriggerPct = 50.0;      // ... layer 4
input double InpLayer5TriggerPct = 65.0;      // ... layer 5
input double InpLayer6TriggerPct = 80.0;      // ... layer 6
input double InpPointsPerPip     = 10.0;      // points per pip. Gold 2-digit: 10 => 1 pip = 0.10 price. Use 100 if you count 1 pip = 1.00
input bool   InpUseStagedTrail   = true;      // staged trailing SL by % of TP (table in code: TRAIL_AT / TRAIL_TO)
input bool   InpUseBEMove        = true;      // per-position breakeven rule
input double InpBEMovePct        = 20.0;      // a position that is > N% of TP in profit gets its SL moved to breakeven

input group "=== Direction engine (re-checked EVERY tick) ==="
input ENUM_TIMEFRAMES   InpTF               = PERIOD_M1;   // bar TF: ATR, confirm-close, hold timer
input ENUM_TIMEFRAMES   InpTrendTF          = PERIOD_M1;   // direction timeframe
input int               InpTrendFast        = 5;           // fast EMA
input int               InpTrendSlow        = 20;          // slow EMA
input bool              InpUseFormingBar    = true;        // true = read EMAs on forming bar (intrabar flips)
input double            InpFlipBandATR      = 0.05;        // hysteresis: EMA gap must pass N x ATR on the other side to flip
input int               InpFlipConfirmMs    = 1500;        // new direction must persist N ms (0 = instant)
input int               InpFlipConfirmTicks = 3;           // ... and at least N ticks
input bool              InpMomentumConfirm  = true;        // flip only if price is on the new side of the fast EMA
input ENUM_TREND_FILTER InpTrendFilter      = TFILT_OFF;   // EMA-trend filter: OFF / block counter-trend ENTRIES only / STRICT
input int               InpEMATrend         = 200;         // trend-filter EMA period
input double            InpEntrySepATR      = 0.10;        // fresh entries need EMA gap >= N x ATR (not applied to reversals)
input bool              InpFlipOnReverse    = true;        // close basket when direction flips
input bool              InpStopAndReverse   = true;        // ... and immediately open the opposite side
input bool              InpIntrabarEntry    = true;        // look for entries on every tick
input int               InpReentryCooldownSec = 3;         // wait after a NON-flip exit before re-entering
input int               InpATRPeriod        = 14;

input group "=== 6-Layer risk pyramid x positions per layer (hedging accounts) ==="
input bool   InpUseLayeredRisk      = true;   // false = margin-ladder mode below
input double InpTotalRiskPct        = 3.0;    // total planned loss for the campaign, % of balance (6 x 0.5%)
input double InpLayerRiskPct        = 0.5;    // risk per LAYER, % of balance (split between its positions)
input int    InpMaxLayers           = 6;      // 1..8
input int    InpPositionsPerLayer   = 5;      // positions opened in EACH layer (1..10)
input double InpInitialStopATR      = 1.0;    // layer-1 stop = N x ATR (used only when InpUseFixedTPSL=false)
input double InpLayer2TriggerR      = 0.5;    // non-fixed mode only: R = initial stop distance
input double InpLayer3TriggerR      = 1.0;
input double InpLayer4TriggerR      = 1.5;    // layers 5+ extrapolate with the same step
input bool   InpRequireConfirmClose = false;  // closed bar beyond trigger required (off = add on the tick)
input double InpBreakevenBufferATR  = 0.05;   // BE = entry + N x ATR

input group "=== Margin-ladder mode (InpUseLayeredRisk=false or netting) ==="
input double InpMarginUsePct     = 30.0;      // max used margin, % of balance
input double InpStepLot          = 0.01;
input double InpMinLot           = 0.01;
input double InpMaxTotalLots     = 0.0;       // absolute basket lot cap (0 = margin rule) - applies to both modes
input int    InpMaxAddsHardCap   = 20;
input bool   InpProgressiveLots  = true;      // 0.01 -> 0.02 -> 0.03 ...
input double InpAddLotFactor     = 1.0;       // used when not progressive
input double InpAddEveryATR      = 0.5;       // add after price advances N x ATR from last entry
input bool   InpAddOnlyInProfit  = true;

input group "=== Basket exit ==="
input ENUM_TARGET_MODE InpTargetMode = TGT_PCT_BALANCE;
input double InpTargetPct        = 4.5;       // ignored when InpUseFixedTPSL (TP does the job)
input double InpTargetCash       = 2.0;
input double InpBasketStopPct    = 3.0;       // money backstop (positions also carry broker SLs)
input double InpTrailStartPct    = 1.5;       // profit-lock: ignored when InpUseFixedTPSL
input double InpTrailLockPct     = 0.5;
input int    InpMaxHoldBars      = 60;        // close a LOSING basket after N bars of InpTF (0 = off)

input group "=== Safety ==="
input bool   InpIgnoreViabilityCheck = true;
input bool   InpVolAdaptiveStop  = true;
input double InpHardRiskCapPct   = 15.0;
input double InpMinSurvivalATR   = 2.0;
input double InpMaxDailyLossPct  = 0.0;       // 0 = off
input double InpDailyProfitLock  = 0.0;       // 0 = off
input int    InpMaxBasketsPerDay = 0;         // 0 = unlimited
input double InpMaxSpreadATR     = 0.0;       // 0 = off

input group "=== Execution ==="
input long   InpMagic            = 990099;
input int    InpDeviationPoints  = 60;
input bool   InpShowDashboard    = true;
input int    InpFontSize         = 9;

//+------------------------------------------------------------------+
//| Staged trailing table (fractions of the TP distance from entry)  |
//| When price has reached TRAIL_AT[i], SL is moved to TRAIL_TO[i].  |
//| Edit here to change the strategy.                                |
//+------------------------------------------------------------------+
#define TRAIL_STAGES 5
const double TRAIL_AT[TRAIL_STAGES] = {0.30,0.50,0.80,0.90,1.00};
const double TRAIL_TO[TRAIL_STAGES] = {0.10,0.35,0.60,0.80,0.90};

//+------------------------------------------------------------------+
CTrade Trade; CPositionInfo Pos; CSymbolInfo Sym;
int    hATR=INVALID_HANDLE,hTrF=INVALID_HANDLE,hTrS=INVALID_HANDLE,hTr200=INVALID_HANDLE;
double atr=0,g_fast=0,g_slow=0,g_e200=0;

// direction engine
int  g_rawDir=0,g_confDir=0,g_pendDir=0,g_pendTicks=0,g_flips=0;
long g_pendSinceMs=0;

// basket
int    g_dir=0,g_adds=0,g_barsHeld=0;
double g_lastEntry=0,g_baseLot=0,g_peakBasket=0;
bool   g_locked=false,g_blocked=false,g_layered=true;
string g_note="starting";
datetime g_day=0,g_lastBar=0,g_lastExitTime=0;
double g_dayStartBalance=0,g_dayPnL=0; int g_dayBaskets=0; bool g_dayStopped=false;
int    g_nBaskets=0,g_nWins=0,g_nLosses=0; double g_grossWin=0,g_grossLoss=0;

// layers / positions
#define MAX_LAYERS 8
#define MAX_POS    80          // 8 layers x 10 positions
ulong  g_pTicket[MAX_POS];
double g_pEntry[MAX_POS],g_pSL[MAX_POS],g_pLots[MAX_POS];
int    g_pLayer[MAX_POS];
int    g_nPos=0;               // live tracked positions
int    g_nLayers=0;            // layers opened in this campaign (never decreases)
double g_campaignR=0,g_campaignSLPrice=0;

// fixed TP / staged trail state
double g_entry0=0;        // layer-1 entry price (reference for % of TP)
double g_tpPrice=0;       // shared TP price for all positions (0 = none)
double g_tpDist=0;        // TP distance in price units
double g_trailSL=0;       // current trailed SL level (0 = not started)
int    g_trailStage=-1;   // index into TRAIL_AT/TRAIL_TO

//+------------------------------------------------------------------+
//| Utilities                                                        |
//+------------------------------------------------------------------+
void     LG(string t,string m){ Print("[",t,"] ",m); }
datetime DayStart(datetime t){ MqlDateTime d; TimeToStruct(t,d); d.hour=0; d.min=0; d.sec=0; return StructToTime(d); }
double   Nrm(double p){ return NormalizeDouble(p,_Digits); }
double   Buf(int h,int sh){ if(h==INVALID_HANDLE) return 0; double b[]; if(CopyBuffer(h,0,sh,1,b)!=1) return 0; return b[0]; }
double   Bal(){ return AccountInfoDouble(ACCOUNT_BALANCE); }
string   DirStr(int d){ return d>0?"BUY":(d<0?"SELL":"flat"); }
double   PipDist(double pips){ return pips*InpPointsPerPip*_Point; }
double   SLPips(){ return InpSLEqualsTP?InpTPPips:InpSLPips; }
int      PosPerLayer(){ return (int)MathMax(1,MathMin(InpPositionsPerLayer,10)); }

double MoneyPerLotPerPrice()
  {
   double tv=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_VALUE),ts=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE);
   if(tv<=0||ts<=0) return 0;
   return tv/ts;
  }
double MinLot(){ return MathMax(SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN),InpMinLot); }
double NormLot(double lots)
  {
   double step=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP); if(step<=0) step=0.01;
   double mx=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);
   lots=MathFloor(lots/step+1e-9)*step;
   if(lots<MinLot()) lots=MinLot();
   if(mx>0 && lots>mx) lots=mx;
   return NormalizeDouble(lots,2);
  }
double StopsDist()
  {
   long lv=SymbolInfoInteger(_Symbol,SYMBOL_TRADE_STOPS_LEVEL),fz=SymbolInfoInteger(_Symbol,SYMBOL_TRADE_FREEZE_LEVEL);
   return (double)MathMax(lv,fz)*_Point+2*_Point;
  }
long NowMs(){ MqlTick t; if(SymbolInfoTick(_Symbol,t)) return (long)t.time_msc; return (long)TimeCurrent()*1000; }
double Mid(){ Sym.RefreshRates(); return (Sym.Bid()+Sym.Ask())*0.5; }

// widen an SL if it violates the broker's stops level
double SafeSL(int dir,double sl)
  {
   Sym.RefreshRates(); double md=StopsDist();
   if(dir>0){ double lim=Sym.Bid()-md; if(sl>lim) sl=lim; }
   else     { double lim=Sym.Ask()+md; if(sl<lim) sl=lim; }
   return Nrm(sl);
  }
bool MarginOK(int dir,double lots)
  {
   double m=0; Sym.RefreshRates();
   double px=(dir>0)?Sym.Ask():Sym.Bid();
   if(!OrderCalcMargin(dir>0?ORDER_TYPE_BUY:ORDER_TYPE_SELL,_Symbol,lots,px,m)) return true;
   return m<AccountInfoDouble(ACCOUNT_MARGIN_FREE)*0.95;
  }

//+------------------------------------------------------------------+
//| Basket helpers                                                   |
//+------------------------------------------------------------------+
bool   Mine(){ return Pos.Symbol()==_Symbol && Pos.Magic()==InpMagic; }
int    BasketCount(){ int n=0; for(int i=PositionsTotal()-1;i>=0;i--) if(Pos.SelectByIndex(i)&&Mine()) n++; return n; }
double BasketLots() { double v=0; for(int i=PositionsTotal()-1;i>=0;i--) if(Pos.SelectByIndex(i)&&Mine()) v+=Pos.Volume(); return v; }
double BasketProfit(){ double p=0; for(int i=PositionsTotal()-1;i>=0;i--) if(Pos.SelectByIndex(i)&&Mine()) p+=Pos.Profit()+Pos.Swap()+Pos.Commission(); return p; }
int    BasketDir()  { for(int i=PositionsTotal()-1;i>=0;i--) if(Pos.SelectByIndex(i)&&Mine()) return (Pos.PositionType()==POSITION_TYPE_BUY)?1:-1; return 0; }

void ResetCampaign()
  {
   g_dir=0; g_adds=0; g_lastEntry=0; g_barsHeld=0; g_peakBasket=0; g_locked=false;
   g_nLayers=0; g_nPos=0; g_campaignR=0; g_campaignSLPrice=0;
   g_entry0=0; g_tpPrice=0; g_tpDist=0; g_trailSL=0; g_trailStage=-1;
  }

void AddPos(ulong tk,double entry,double sl,double lots,int layer)
  {
   if(g_nPos>=MAX_POS) return;
   g_pTicket[g_nPos]=tk; g_pEntry[g_nPos]=entry; g_pSL[g_nPos]=sl; g_pLots[g_nPos]=lots; g_pLayer[g_nPos]=layer;
   g_nPos++;
  }

void CloseBasket(string why)
  {
   double pnl=BasketProfit();
   for(int pass=0;pass<3;pass++)
     {
      bool any=false;
      for(int i=PositionsTotal()-1;i>=0;i--)
         if(Pos.SelectByIndex(i)&&Mine()){ Trade.PositionClose(Pos.Ticket(),InpDeviationPoints); any=true; }
      if(!any) break;
     }
   if(BasketCount()==0)
     {
      g_dayPnL+=pnl; g_nBaskets++;
      if(pnl>0){ g_nWins++; g_grossWin+=pnl; } else if(pnl<0){ g_nLosses++; g_grossLoss+=-pnl; }
      LG("BASKET",StringFormat("closed (%s) pnl %.2f | day %+.2f",why,pnl,g_dayPnL));
      ResetCampaign(); g_lastExitTime=TimeCurrent();
     }
   else LG("ERROR",StringFormat("close incomplete: %d position(s) still open",BasketCount()));
  }

//+------------------------------------------------------------------+
//| Direction engine - called every tick                             |
//+------------------------------------------------------------------+
void UpdateDirection()
  {
   int sh=InpUseFormingBar?0:1;
   double f=Buf(hTrF,sh),s=Buf(hTrS,sh);
   if(f<=0||s<=0) return;
   g_fast=f; g_slow=s;
   g_e200=(hTr200!=INVALID_HANDLE)?Buf(hTr200,sh):0;

   // hysteresis: inside the band the previous raw direction is kept
   double band=InpFlipBandATR*atr,gap=f-s;
   if(gap>band) g_rawDir=1; else if(gap<-band) g_rawDir=-1;

   int cand=g_rawDir;
   double mid=Mid();
   if(InpMomentumConfirm && cand!=0 && cand!=g_confDir)
      if((cand>0 && mid<=f)||(cand<0 && mid>=f)) cand=g_confDir;
   if(InpTrendFilter==TFILT_STRICT && g_e200>0 && cand!=0)
      if((cand>0 && mid<g_e200)||(cand<0 && mid>g_e200)) cand=0;

   long now=NowMs();
   if(cand==g_confDir){ g_pendDir=cand; g_pendTicks=0; g_pendSinceMs=now; return; }
   if(cand!=g_pendDir){ g_pendDir=cand; g_pendTicks=1; g_pendSinceMs=now; }
   else g_pendTicks++;

   bool first=(g_confDir==0 && cand!=0);
   if(first || ((now-g_pendSinceMs)>=InpFlipConfirmMs && g_pendTicks>=InpFlipConfirmTicks))
     {
      if(g_confDir!=0 && cand!=0) g_flips++;
      LG("DIR",StringFormat("%s -> %s  (gap %.2f, band %.2f, %d ticks, %d ms)",DirStr(g_confDir),DirStr(cand),gap,band,g_pendTicks,(int)(now-g_pendSinceMs)));
      g_confDir=cand; g_pendTicks=0;
     }
  }

// direction allowed for a new campaign
int EntryDirection(bool isReverse)
  {
   int d=g_confDir; if(d==0) return 0;
   if(InpTrendFilter==TFILT_ENTRY_ONLY && g_e200>0)
     { double mid=Mid(); if((d>0&&mid<g_e200)||(d<0&&mid>g_e200)){ g_note="entry blocked: against EMA"+IntegerToString(InpEMATrend); return 0; } }
   if(!isReverse && InpEntrySepATR>0 && atr>0 && MathAbs(g_fast-g_slow)<InpEntrySepATR*atr){ g_note="EMAs too close for fresh entry"; return 0; }
   return d;
  }

//+------------------------------------------------------------------+
//| Order execution                                                  |
//+------------------------------------------------------------------+
bool SendMarket(int dir,double lots,double sl,double tp,double &fillPx,ulong &posTicket,string cmt)
  {
   fillPx=0; posTicket=0;
   int fm=(int)SymbolInfoInteger(_Symbol,SYMBOL_FILLING_MODE);
   ENUM_ORDER_TYPE_FILLING tries[3]={ORDER_FILLING_IOC,ORDER_FILLING_FOK,ORDER_FILLING_RETURN};
   bool slDropped=false;
   for(int a=0;a<3;a++)
     {
      if(tries[a]==ORDER_FILLING_IOC && (fm&SYMBOL_FILLING_IOC)==0) continue;
      if(tries[a]==ORDER_FILLING_FOK && (fm&SYMBOL_FILLING_FOK)==0) continue;
      Trade.SetTypeFilling(tries[a]);
      Sym.RefreshRates();
      double s=(sl>0)?Nrm(sl):0;
      double t=(tp>0)?Nrm(tp):0;
      bool ok=(dir>0)?Trade.Buy(lots,_Symbol,0,s,t,cmt):Trade.Sell(lots,_Symbol,0,s,t,cmt);
      uint rc=Trade.ResultRetcode();
      if(ok && (rc==TRADE_RETCODE_DONE||rc==TRADE_RETCODE_DONE_PARTIAL||rc==TRADE_RETCODE_PLACED))
        {
         fillPx=Trade.ResultPrice(); if(fillPx<=0) fillPx=(dir>0)?Sym.Ask():Sym.Bid();
         ulong deal=Trade.ResultDeal();
         if(deal>0 && HistoryDealSelect(deal)) posTicket=(ulong)HistoryDealGetInteger(deal,DEAL_POSITION_ID);
         if(posTicket==0) posTicket=Trade.ResultOrder();
         return true;
        }
      LG("ERROR",StringFormat("send %s %.2f failed: %u %s",DirStr(dir),lots,rc,Trade.ResultRetcodeDescription()));
      if(rc==TRADE_RETCODE_INVALID_STOPS && (sl>0||tp>0) && !slDropped){ sl=0; tp=0; slDropped=true; a--; continue; } // retry naked, SL/TP set after
      if(rc!=TRADE_RETCODE_INVALID_FILL) return false;
     }
   return false;
  }

// make sure the position has an SL (and TP if wanted); returns the SL actually on the position (0 if none)
double EnsureSL(ulong tk,int dir,double wantSL,double wantTP)
  {
   if(tk==0||!PositionSelectByTicket(tk)) return 0;
   double cur=PositionGetDouble(POSITION_SL),ctp=PositionGetDouble(POSITION_TP);
   if(cur>0 && (wantTP<=0||ctp>0)) return cur;
   double s=(cur>0)?cur:SafeSL(dir,wantSL);
   double t=(ctp>0)?ctp:((wantTP>0)?Nrm(wantTP):0);
   if(Trade.PositionModify(tk,s,t)) return s;
   LG("WARN",StringFormat("could not attach SL/TP to #%I64u: %s",tk,Trade.ResultRetcodeDescription()));
   return cur;
  }

//+------------------------------------------------------------------+
//| Ladder-mode sizing                                               |
//+------------------------------------------------------------------+
double MarginPerLot(){ double m=0; if(!OrderCalcMargin(ORDER_TYPE_BUY,_Symbol,1.0,SymbolInfoDouble(_Symbol,SYMBOL_ASK),m)) return 0; return m; }
double BaseLot(){ return NormLot(InpStepLot>0?InpStepLot:MinLot()); }
int LadderSteps()
  {
   double mpl=MarginPerLot(),b=BaseLot(); if(mpl<=0||b<=0) return 1;
   int steps=(int)MathFloor((Bal()*InpMarginUsePct/100.0/mpl)/b);
   return (int)MathMax(1,MathMin(steps,InpMaxAddsHardCap+1));
  }
int MaxAdds(){ return (InpMarginUsePct>0)?LadderSteps()-1:InpMaxAddsHardCap; }
double MaxTotalLots()
  {
   if(InpMaxTotalLots>0) return InpMaxTotalLots;
   if(InpMarginUsePct>0){ double mm=MarginPerLot(); if(mm>0) return (Bal()*InpMarginUsePct/100.0)/mm; }
   return BaseLot()*(1+InpMaxAddsHardCap);
  }
double StopCash()
  {
   double bal=Bal(),cash=bal*InpBasketStopPct/100.0;
   if(InpVolAdaptiveStop && atr>0)
     { double need=BasketLots()*MoneyPerLotPerPrice()*InpMinSurvivalATR*atr; if(need>cash) cash=need; }
   return MathMin(cash,bal*InpHardRiskCapPct/100.0);
  }
bool ViabilityCheck(string &why)
  {
   double mpl=MoneyPerLotPerPrice();
   if(mpl<=0||atr<=0){ why="no tick/ATR data yet"; return false; }
   double riskCash=MinLot()*mpl*InpMinSurvivalATR*atr;
   double pct=(Bal()>0)?riskCash/Bal()*100.0:999.0;
   if(pct>InpHardRiskCapPct)
     { why=StringFormat("one %.2f lot risks %.1f%% over %.1f x ATR (cap %.1f%%). Min viable balance ~%.0f",MinLot(),pct,InpMinSurvivalATR,InpHardRiskCapPct,riskCash/(InpHardRiskCapPct/100.0)); return false; }
   return true;
  }

bool OpenBase(int dir)
  {
   double lots=BaseLot(),cap=MaxTotalLots();
   if(cap>0 && lots>cap) lots=NormLot(cap);
   if(!MarginOK(dir,lots)){ g_note="not enough free margin"; return false; }
   double fill; ulong tk;
   if(!SendMarket(dir,lots,0,0,fill,tk,"pyr")) return false;
   g_dir=dir; g_adds=0; g_lastEntry=fill; g_baseLot=lots; g_barsHeld=0; g_peakBasket=0; g_locked=false; g_dayBaskets++;
   LG("OPEN",StringFormat("BASE %s %.2f @ %s (bal %.2f, cap %.2f lots)",DirStr(dir),lots,DoubleToString(fill,_Digits),Bal(),cap));
   return true;
  }

void TryPyramid()
  {
   if(g_dir==0 || g_adds>=MaxAdds()) return;
   if(InpAddOnlyInProfit && BasketProfit()<=0) return;
   if(g_confDir!=g_dir) return;
   Sym.RefreshRates();
   double px=(g_dir>0)?Sym.Bid():Sym.Ask();
   if(g_dir*(px-g_lastEntry)<InpAddEveryATR*atr) return;
   double lots=InpProgressiveLots?InpStepLot*(g_adds+2):g_baseLot*MathPow(InpAddLotFactor,g_adds+1);
   lots=NormLot(lots);
   double cap=MaxTotalLots();
   if(cap>0 && BasketLots()+lots>cap){ g_note=StringFormat("ladder full (%.2f/%.2f)",BasketLots(),cap); return; }
   if(!MarginOK(g_dir,lots)){ g_note="not enough free margin to add"; return; }
   double fill; ulong tk;
   if(!SendMarket(g_dir,lots,0,0,fill,tk,"pyr")) return;
   g_adds++; g_lastEntry=fill;
   LG("PYRAMID",StringFormat("add #%d %.2f @ %s  basket %.2f lots",g_adds,lots,DoubleToString(fill,_Digits),BasketLots()));
  }

