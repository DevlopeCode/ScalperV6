   else Lbl("p",x,y+lh*i++,"pending -",cM);
   if(BasketCount()>0) Lbl("e",x,y+lh*i++,StringFormat("IN %s  %d pos  %.2f lots  P/L %.2f %s",g_dir>0?"LONG":"SHORT",BasketCount(),BasketLots(),prof,g_locked?"LOCKED":""),prof>=0?cG:cR);
   else                Lbl("e",x,y+lh*i++,"FLAT",cM);
   double target=(InpTargetMode==TGT_PCT_BALANCE)?bal*InpTargetPct/100.0:InpTargetCash;
   if(g_layered)
     {
      double progR=0,progTP=0;
      if(g_nLayers>0 && g_campaignR>0){ Sym.RefreshRates(); double p=(g_dir>0)?Sym.Bid():Sym.Ask(); progR=g_dir*(p-g_entry0)/g_campaignR; if(g_tpDist>0) progTP=g_dir*(p-g_entry0)/g_tpDist*100.0; }
      if(InpUseFixedTPSL)
         Lbl("f",x,y+lh*i++,StringFormat("TP %s  SL %s  @ %.0f%% TP  stage %d/%d",g_tpPrice>0?DoubleToString(g_tpPrice,_Digits):"-",g_trailSL>0?DoubleToString(g_trailSL,_Digits):(g_campaignSLPrice>0?DoubleToString(g_campaignSLPrice,_Digits):"-"),progTP,g_trailStage+1,TRAIL_STAGES),cM);
      else
         Lbl("f",x,y+lh*i++,StringFormat("target +%.2f  SL %s  @ %.2fR (next %.2fR)",target,g_campaignSLPrice>0?DoubleToString(g_campaignSLPrice,_Digits):"-",progR,LayerTriggerR(g_nLayers)),cM);
     }
   else Lbl("f",x,y+lh*i++,StringFormat("target +%.2f  stop -%.2f  rung %d/%d",target,StopCash(),g_adds,MaxAdds()),cM);
   Lbl("g",x,y+lh*i++,StringFormat("Day %+.2f  baskets %d %s",g_dayPnL,g_dayBaskets,g_dayStopped?"STOPPED":""),g_dayPnL>=0?cG:cR);
   int cl=g_nWins+g_nLosses;
   Lbl("h",x,y+lh*i++,StringFormat("Session %d baskets  win %.0f%%  PF %.2f",cl,cl>0?100.0*g_nWins/cl:0,g_grossLoss>0?g_grossWin/g_grossLoss:0),cH);
   Lbl("i",x,y+lh*i++,(g_blocked?"BLOCKED: ":"Note: ")+g_note,g_blocked?cR:cY);
   ChartRedraw(0);
  }

