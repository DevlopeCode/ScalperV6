int OnInit()
  {
   Sym.Name(_Symbol);
   Trade.SetExpertMagicNumber(InpMagic); Trade.SetDeviationInPoints(InpDeviationPoints); Trade.LogLevel(LOG_LEVEL_ERRORS);
   hATR=iATR(_Symbol,InpTF,InpATRPeriod);
   hTrF=iMA(_Symbol,InpTrendTF,InpTrendFast,0,MODE_EMA,PRICE_CLOSE);
   hTrS=iMA(_Symbol,InpTrendTF,InpTrendSlow,0,MODE_EMA,PRICE_CLOSE);
   if(InpTrendFilter!=TFILT_OFF && InpEMATrend>0) hTr200=iMA(_Symbol,InpTrendTF,InpEMATrend,0,MODE_EMA,PRICE_CLOSE);
   if(hATR==INVALID_HANDLE||hTrF==INVALID_HANDLE||hTrS==INVALID_HANDLE){ LG("ERROR","indicator handle failed"); return INIT_FAILED; }
   if(InpTrendFast>=InpTrendSlow){ LG("ERROR","InpTrendFast must be < InpTrendSlow"); return INIT_PARAMETERS_INCORRECT; }
   if(InpUseFixedTPSL && (InpTPPips<=0||SLPips()<=0||InpPointsPerPip<=0)){ LG("ERROR","TP/SL pips and points-per-pip must be > 0"); return INIT_PARAMETERS_INCORRECT; }
   if(InpPositionsPerLayer<1||InpPositionsPerLayer>10){ LG("ERROR","InpPositionsPerLayer must be 1..10"); return INIT_PARAMETERS_INCORRECT; }

   bool hedging=(AccountInfoInteger(ACCOUNT_MARGIN_MODE)==ACCOUNT_MARGIN_MODE_RETAIL_HEDGING);
   g_layered=InpUseLayeredRisk && hedging;
   if(InpUseLayeredRisk && !hedging)
      LG("WARN","NETTING account: positions would merge into one, so per-position SL/breakeven cannot work. Running LADDER mode (fixed TP/SL, 5 positions per layer and staged trail are NOT active in ladder mode).");

   g_day=DayStart(TimeCurrent()); g_dayStartBalance=Bal();
   atr=Buf(hATR,1);
   RecoverState();

   LG("INFO",StringFormat("v4.03 on %s | bal %.2f | $/1.0 price/lot %.2f | direction EMA%d/%d %s on %s bar | band %.2fxATR | confirm %d ms + %d ticks | trend filter %s | SAR %s | 24/7",
        _Symbol,Bal(),MoneyPerLotPerPrice(),InpTrendFast,InpTrendSlow,EnumToString(InpTrendTF),InpUseFormingBar?"FORMING":"closed",
        InpFlipBandATR,InpFlipConfirmMs,InpFlipConfirmTicks,EnumToString(InpTrendFilter),InpStopAndReverse?"on":"off"));
   if(g_layered) LG("INFO",StringFormat("LAYERED: %d layers x %d positions | %.1f%% risk per layer = %.1f%% planned total",NumLayersAllowed(),PosPerLayer(),InpLayerRiskPct,InpLayerRiskPct*NumLayersAllowed()));
   if(g_layered && InpUseFixedTPSL)
     {
      LG("INFO",StringFormat("FIXED TP/SL: TP %.0f pips (%.2f price) | SL %.0f pips (%.2f price) | 1 pip = %.0f points | staged trail %s | BE at %.0f%% TP %s",
           InpTPPips,PipDist(InpTPPips),SLPips(),PipDist(SLPips()),InpPointsPerPip,InpUseStagedTrail?"ON":"OFF",InpBEMovePct,InpUseBEMove?"ON":"OFF"));
      LG("INFO",StringFormat("LAYER TRIGGERS (%% of TP): L2 %.0f | L3 %.0f | L4 %.0f | L5 %.0f | L6 %.0f",
           InpLayer2TriggerPct,InpLayer3TriggerPct,InpLayer4TriggerPct,InpLayer5TriggerPct,InpLayer6TriggerPct));
     }
   string vw; if(atr>0 && !ViabilityCheck(vw)) LG("WARN","ACCOUNT SMALL FOR CURRENT VOLATILITY: "+vw);
   EventSetTimer(1);
   return INIT_SUCCEEDED;
  }

void OnDeinit(const int reason)
  {
   EventKillTimer();
   if(hATR!=INVALID_HANDLE) IndicatorRelease(hATR);
   if(hTrF!=INVALID_HANDLE) IndicatorRelease(hTrF);
   if(hTrS!=INVALID_HANDLE) IndicatorRelease(hTrS);
   if(hTr200!=INVALID_HANDLE) IndicatorRelease(hTr200);
   if(reason!=REASON_CHARTCHANGE && reason!=REASON_PARAMETERS) ObjectsDeleteAll(0,"PYR_");
  }

void OnTick()
  {
   atr=Buf(hATR,1);
   if(atr<=0) return;
   UpdateDirection();                          // every tick
   if(g_layered){ SyncLayers(); ApplyStagedTrail(); ApplyBreakevenRule(); }   // trail SL + per-position BE on every tick
   ManageBasket();                             // includes stop-and-reverse
   if(BasketCount()>0){ if(g_layered) TryLayeredPyramid(); else TryPyramid(); }
   else if(InpIntrabarEntry) TryEntry();
   datetime bt=iTime(_Symbol,InpTF,0);
   if(bt!=g_lastBar && bt!=0){ g_lastBar=bt; OnNewBar(); if(MQLInfoInteger(MQL_TESTER)) Dashboard(); }
  }

void OnTimer(){ if(!MQLInfoInteger(MQL_TESTER)) Dashboard(); }

double OnTester()
  {
   int cl=g_nWins+g_nLosses;
   Print(StringFormat("===== v4.03: %d baskets  win %.1f%%  PF %.2f  net %.2f  flips %d =====",
        cl,cl>0?100.0*g_nWins/cl:0,g_grossLoss>0?g_grossWin/g_grossLoss:0,g_grossWin-g_grossLoss,g_flips));
   double pf=TesterStatistics(STAT_PROFIT_FACTOR),tr=TesterStatistics(STAT_TRADES),dd=TesterStatistics(STAT_EQUITY_DDREL_PERCENT);
   if(tr<30) return 0;
   return MathMin(pf,3.0)*MathSqrt(MathMin(tr,300.0))-dd/5.0;
  }
