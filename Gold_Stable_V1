void     LG(string t,string m){ Print("[",t,"] ",m); }
datetime DayStart(datetime t){ MqlDateTime d; TimeToStruct(t,d); d.hour=0; d.min=0; d.sec=0; return StructToTime(d); }
double   Nrm(double p){ return NormalizeDouble(p,_Digits); }
double   Buf(int h,int sh){ if(h==INVALID_HANDLE) return 0; double b[]; if(CopyBuffer(h,0,sh,1,b)!=1) return 0; return b[0]; }
double   Buf2(int h,int buf,int sh){ if(h==INVALID_HANDLE) return 0; double b[]; if(CopyBuffer(h,buf,sh,1,b)!=1) return 0; return b[0]; }
double   Bal(){ return AccountInfoDouble(ACCOUNT_BALANCE); }
string   DirStr(int d){ return d>0?"BUY":(d<0?"SELL":"flat"); }
double   PipDist(double pips){ return pips*InpPointsPerPip*_Point; }
bool     InTester(){ return (bool)MQLInfoInteger(MQL_TESTER); }

double MoneyPerLotPerPrice()
  {
   double tv=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_VALUE),ts=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE);
   if(tv<=0||ts<=0) return 0;
   return tv/ts;
  }
double NormLot(double lots)
  {
   double step=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP); if(step<=0) step=0.01;
   double mn=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN),mx=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);
   lots=MathFloor(lots/step+1e-9)*step;
   if(lots<mn) lots=mn;
   if(mx>0 && lots>mx) lots=mx;
   return NormalizeDouble(lots,2);
  }
// Backtest: always InpTesterLot.  Live/demo: one InpLotPerStep per InpBalancePerStep of balance (minimum one step).
double CalcLots()
  {
   double lots;
   if(InTester() || InpFixedLotEverywhere) lots=InpTesterLot;
   else
     {
      int steps=(int)MathFloor(Bal()/MathMax(InpBalancePerStep,1.0)+1e-9);
      if(steps<1) steps=1;
      lots=steps*InpLotPerStep;
     }
   if(InpMaxLot>0 && lots>InpMaxLot) lots=InpMaxLot;
   return NormLot(lots);
  }
double StopsDist()
  {
   long lv=SymbolInfoInteger(_Symbol,SYMBOL_TRADE_STOPS_LEVEL),fz=SymbolInfoInteger(_Symbol,SYMBOL_TRADE_FREEZE_LEVEL);
   return (double)MathMax(lv,fz)*_Point+2*_Point;
  }
long   NowMs(){ MqlTick t; if(SymbolInfoTick(_Symbol,t)) return (long)t.time_msc; return (long)TimeCurrent()*1000; }
double Mid(){ Sym.RefreshRates(); return (Sym.Bid()+Sym.Ask())*0.5; }

// widen an SL if it violates the broker's stops level
double SafeSL(int dir,double sl)
  {
   Sym.RefreshRates(); double md=StopsDist();
   if(dir>0){ double lim=Sym.Bid()-md; if(sl>lim) sl=lim; }
   else     { double lim=Sym.Ask()+md; if(sl<lim) sl=lim; }
   return Nrm(sl);
  }
bool MarginOK(int dir,double lots)
  {
   double m=0; Sym.RefreshRates();
   double px=(dir>0)?Sym.Ask():Sym.Bid();
   if(!OrderCalcMargin(dir>0?ORDER_TYPE_BUY:ORDER_TYPE_SELL,_Symbol,lots,px,m)) return true;
   return m<AccountInfoDouble(ACCOUNT_MARGIN_FREE)*0.95;
  }

