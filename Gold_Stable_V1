string JHead(string ev,ulong ticket)
  {
   return "{"+JS("token",InpSheetToken)+","+JS("event",ev)+","+JS("ticket",StringFormat("%I64u",ticket))+","+JS("symbol",_Symbol)
          +","+JS("account",StringFormat("%I64d",AccountInfoInteger(ACCOUNT_LOGIN)))+","+JS("mode",ModeStr());
  }
void QPush(string j)
  {
   int n=ArraySize(g_q);
   if(n>=500){ for(int i=1;i<n;i++) g_q[i-1]=g_q[i]; n--; ArrayResize(g_q,n); }
   ArrayResize(g_q,n+1); g_q[n]=j;
  }
void QPop()
  {
   int n=ArraySize(g_q); if(n==0) return;
   for(int i=1;i<n;i++) g_q[i-1]=g_q[i];
   ArrayResize(g_q,n-1);
  }
// indicator snapshot for the OPEN row (last closed bar of InpRptTF; candle gap = forming-bar open minus previous close)
string IndicatorJson()
  {
   int sh=1;
   double e9=Buf2(hR_E9,0,sh),e20=Buf2(hR_E20,0,sh),s9=Buf2(hR_S9,0,sh);
   double adx=Buf2(hR_ADX,0,sh),pdi=Buf2(hR_ADX,1,sh),mdi=Buf2(hR_ADX,2,sh);
   double a=Buf2(hR_ATR,0,sh);
   double bm=Buf2(hR_BB,0,sh),bu=Buf2(hR_BB,1,sh),bl=Buf2(hR_BB,2,sh);
   double pip=InpPointsPerPip*_Point;
   double c1=iClose(_Symbol,InpRptTF,1);
   double pctB=(bu-bl>0)?(c1-bl)/(bu-bl):0;                 // 0 = lower band, 1 = upper band
   double gap=(pip>0)?(iOpen(_Symbol,InpRptTF,0)-c1)/pip:0; // + = gap up, - = gap down
   return ","+JN("ema9",e9,_Digits)+","+JN("ema20",e20,_Digits)+","+JN("sma9",s9,_Digits)
         +","+JN("adx",adx,2)+","+JN("plus_di",pdi,2)+","+JN("minus_di",mdi,2)
         +","+JN("atr",a,2)+","+JN("atr_pips",(pip>0)?a/pip:0,1)
         +","+JN("bb_upper",bu,_Digits)+","+JN("bb_mid",bm,_Digits)+","+JN("bb_lower",bl,_Digits)+","+JN("bb_pctb",pctB,3)
         +","+JN("candle_gap_pips",gap,1);
  }
void QueueOpen(ulong tk)
  {
   if(!SheetOn() || !PositionSelectByTicket(tk)) return;
   int dir=(PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY)?1:-1;
   string j=JHead("OPEN",tk)
      +","+JS("type",dir>0?"BUY":"SELL")
      +","+JN("lots",PositionGetDouble(POSITION_VOLUME),2)
      +","+JS("open_time",TStr((datetime)PositionGetInteger(POSITION_TIME)))
      +","+JN("open_price",PositionGetDouble(POSITION_PRICE_OPEN),_Digits)
      +","+JN("sl",PositionGetDouble(POSITION_SL),_Digits)
      +","+JN("tp",PositionGetDouble(POSITION_TP),_Digits)
      +","+JN("balance",Bal(),2)
      +","+JN("equity",AccountInfoDouble(ACCOUNT_EQUITY),2)
      +IndicatorJson()+"}";
   QPush(j);
  }

// read the finished position from deal history, update stats, queue the CLOSE row. false = history not ready yet.
bool BuildCloseReport(ulong posId)
  {
   if(!HistorySelectByPosition(posId)) return false;
   int total=HistoryDealsTotal();
   bool out=false; int dir=0;
   datetime openT=0,closeT=0; double openP=0,closeP=0,lots=0,profit=0,swap=0,comm=0,fee=0; long reason=0;
   for(int i=0;i<total;i++)
     {
      ulong dt=HistoryDealGetTicket(i); if(dt==0) continue;
      long en=HistoryDealGetInteger(dt,DEAL_ENTRY);
      profit+=HistoryDealGetDouble(dt,DEAL_PROFIT);
      swap  +=HistoryDealGetDouble(dt,DEAL_SWAP);
      comm  +=HistoryDealGetDouble(dt,DEAL_COMMISSION);
      fee   +=HistoryDealGetDouble(dt,DEAL_FEE);
      if(en==DEAL_ENTRY_IN)
        {
         openT=(datetime)HistoryDealGetInteger(dt,DEAL_TIME); openP=HistoryDealGetDouble(dt,DEAL_PRICE);
         lots=HistoryDealGetDouble(dt,DEAL_VOLUME);
         dir=(HistoryDealGetInteger(dt,DEAL_TYPE)==DEAL_TYPE_BUY)?1:-1;
        }
      else if(en==DEAL_ENTRY_OUT||en==DEAL_ENTRY_OUT_BY||en==DEAL_ENTRY_INOUT)
        {
         out=true; closeT=(datetime)HistoryDealGetInteger(dt,DEAL_TIME); closeP=HistoryDealGetDouble(dt,DEAL_PRICE);
         reason=HistoryDealGetInteger(dt,DEAL_REASON);
        }
     }
   if(!out) return false;

   double net=profit+swap+comm+fee;
   double pips=(dir!=0)?dir*(closeP-openP)/(InpPointsPerPip*_Point):0;
   g_dayPnL+=net; g_nTrades++;
   if(net>0){ g_nWins++; g_grossWin+=net; } else if(net<0){ g_nLosses++; g_grossLoss+=-net; }
   LG("TRADE",StringFormat("#%I64u %s %.2f closed by %s | %.1f pips | net %.2f | day %+.2f",posId,DirStr(dir),lots,ReasonStr(reason),pips,net,g_dayPnL));

   if(SheetOn())
     {
      string j=JHead("CLOSE",posId)
         +","+JS("type",dir>0?"BUY":"SELL")
         +","+JN("lots",lots,2)
         +","+JS("open_time",TStr(openT))
         +","+JN("open_price",openP,_Digits)
         +","+JS("close_time",TStr(closeT))
         +","+JN("close_price",closeP,_Digits)
         +","+JS("reason",ReasonStr(reason))
         +","+JN("profit",profit,2)
         +","+JN("swap",swap,2)
         +","+JN("commission",comm+fee,2)
         +","+JN("net",net,2)
         +","+JN("pips",pips,1)
         +","+JN("balance",Bal(),2)
         +","+JN("equity",AccountInfoDouble(ACCOUNT_EQUITY),2)+"}";
      QPush(j);
     }
   return true;
  }

// the tracked position vanished (SL / TP / flip / manual): park it until its deals are readable
void CheckClosed()
  {
   if(g_ticket==0) return;
   if(PositionSelectByTicket(g_ticket)) return;
   int n=ArraySize(g_pend);
   ArrayResize(g_pend,n+1); ArrayResize(g_pendT,n+1);
   g_pend[n]=g_ticket; g_pendT[n]=TimeCurrent();
   g_ticket=0; g_dir=0; g_trailStage=-1; g_barsHeld=0; g_lastExitTime=TimeCurrent();
  }
void ProcessPending()
  {
   for(int i=ArraySize(g_pend)-1;i>=0;i--)
     {
      bool done=BuildCloseReport(g_pend[i]);
      if(!done && (TimeCurrent()-g_pendT[i])>60){ LG("WARN",StringFormat("no close deal found for #%I64u after 60 s - not reported",g_pend[i])); done=true; }
      if(done)
        {
         int n=ArraySize(g_pend);
         for(int k=i+1;k<n;k++){ g_pend[k-1]=g_pend[k]; g_pendT[k-1]=g_pendT[k]; }
         ArrayResize(g_pend,n-1); ArrayResize(g_pendT,n-1);
        }
     }
  }

// called from OnTimer so the trading logic is never blocked by the network
void FlushQueue()
  {
   if(!SheetOn() || ArraySize(g_q)==0) return;
   if(TimeLocal()<g_nextSend) return;
   char data[],res[]; string rh;
   int n=StringToCharArray(g_q[0],data,0,WHOLE_ARRAY,CP_UTF8);
   if(n>0) ArrayResize(data,n-1);                 // drop the terminating zero
   ResetLastError();
   int code=WebRequest("POST",InpSheetURL,"Content-Type: application/json\r\n",InpWebTimeoutMs,data,res,rh);
   if(code==200||code==201||code==302||code==303)
     { QPop(); g_failCount=0; g_nextSend=0; return; }
   g_failCount++;
   int err=GetLastError();
   if(g_failCount<=3 || g_failCount%20==0)
     {
      if(code==-1) LG("SHEET",StringFormat("WebRequest failed, error %d%s (will retry)",err,err==4060?" - add the URL under Tools > Options > Expert Advisors > Allow WebRequest":""));
      else         LG("SHEET",StringFormat("server answered HTTP %d (will retry): %s",code,CharArrayToString(res,0,200,CP_UTF8)));
     }
   g_nextSend=TimeLocal()+(datetime)MathMin(60,5*g_failCount);
  }

//+------------------------------------------------------------------+
//| Direction engine - called every tick                             |
//+------------------------------------------------------------------+
void UpdateDirection()
  {
   int sh=InpUseFormingBar?0:1;
   double f=Buf(hTrF,sh),s=Buf(hTrS,sh);
   if(f<=0||s<=0) return;
   g_fast=f; g_slow=s;
   g_e200=(hTr200!=INVALID_HANDLE)?Buf(hTr200,sh):0;

   // hysteresis: inside the band the previous raw direction is kept
   double band=InpFlipBandATR*atr,gap=f-s;
   if(gap>band) g_rawDir=1; else if(gap<-band) g_rawDir=-1;

   int cand=g_rawDir;
   double mid=Mid();
   if(InpMomentumConfirm && cand!=0 && cand!=g_confDir)
      if((cand>0 && mid<=f)||(cand<0 && mid>=f)) cand=g_confDir;
   if(InpTrendFilter==TFILT_STRICT && g_e200>0 && cand!=0)
      if((cand>0 && mid<g_e200)||(cand<0 && mid>g_e200)) cand=0;

   long now=NowMs();
   if(cand==g_confDir){ g_pendDir=cand; g_pendTicks=0; g_pendSinceMs=now; return; }
   if(cand!=g_pendDir){ g_pendDir=cand; g_pendTicks=1; g_pendSinceMs=now; }
   else g_pendTicks++;

   bool first=(g_confDir==0 && cand!=0);
   if(first || ((now-g_pendSinceMs)>=InpFlipConfirmMs && g_pendTicks>=InpFlipConfirmTicks))
     {
      if(g_confDir!=0 && cand!=0) g_flips++;
      LG("DIR",StringFormat("%s -> %s  (gap %.2f, band %.2f, %d ticks, %d ms)",DirStr(g_confDir),DirStr(cand),gap,band,g_pendTicks,(int)(now-g_pendSinceMs)));
      g_confDir=cand; g_pendTicks=0;
     }
  }

// direction allowed for a new position
int EntryDirection(bool isReverse)
  {
   int d=g_confDir; if(d==0) return 0;
   if(InpTrendFilter==TFILT_ENTRY_ONLY && g_e200>0)
     { double mid=Mid(); if((d>0&&mid<g_e200)||(d<0&&mid>g_e200)){ g_note="entry blocked: against EMA"+IntegerToString(InpEMATrend); return 0; } }
   if(!isReverse && InpEntrySepATR>0 && atr>0 && MathAbs(g_fast-g_slow)<InpEntrySepATR*atr){ g_note="EMAs too close for fresh entry"; return 0; }
   return d;
  }

//+------------------------------------------------------------------+
//| Order execution                                                  |
//+------------------------------------------------------------------+
bool SendMarket(int dir,double lots,double sl,double tp,double &fillPx,ulong &posTicket,string cmt)
  {
   fillPx=0; posTicket=0;
   int fm=(int)SymbolInfoInteger(_Symbol,SYMBOL_FILLING_MODE);
   ENUM_ORDER_TYPE_FILLING tries[3]={ORDER_FILLING_IOC,ORDER_FILLING_FOK,ORDER_FILLING_RETURN};
   bool slDropped=false;
   for(int a=0;a<3;a++)
     {
      if(tries[a]==ORDER_FILLING_IOC && (fm&SYMBOL_FILLING_IOC)==0) continue;
      if(tries[a]==ORDER_FILLING_FOK && (fm&SYMBOL_FILLING_FOK)==0) continue;
      Trade.SetTypeFilling(tries[a]);
      Sym.RefreshRates();
      double s=(sl>0)?Nrm(sl):0;
      double t=(tp>0)?Nrm(tp):0;
      bool ok=(dir>0)?Trade.Buy(lots,_Symbol,0,s,t,cmt):Trade.Sell(lots,_Symbol,0,s,t,cmt);
      uint rc=Trade.ResultRetcode();
      if(ok && (rc==TRADE_RETCODE_DONE||rc==TRADE_RETCODE_DONE_PARTIAL||rc==TRADE_RETCODE_PLACED))
        {
         fillPx=Trade.ResultPrice(); if(fillPx<=0) fillPx=(dir>0)?Sym.Ask():Sym.Bid();
         ulong deal=Trade.ResultDeal();
         if(deal>0 && HistoryDealSelect(deal)) posTicket=(ulong)HistoryDealGetInteger(deal,DEAL_POSITION_ID);
         if(posTicket==0) posTicket=Trade.ResultOrder();
         return true;
        }
      LG("ERROR",StringFormat("send %s %.2f failed: %u %s",DirStr(dir),lots,rc,Trade.ResultRetcodeDescription()));
      if(rc==TRADE_RETCODE_INVALID_STOPS && (sl>0||tp>0) && !slDropped){ sl=0; tp=0; slDropped=true; a--; continue; } // retry naked, SL/TP set after
      if(rc!=TRADE_RETCODE_INVALID_FILL) return false;
     }
   return false;
  }

//+------------------------------------------------------------------+
//| Open the single position                                         |
//+------------------------------------------------------------------+
bool OpenTrade(int dir)
  {
   Sym.RefreshRates();
   double spread=Sym.Ask()-Sym.Bid();
   double slDist=MathMax(PipDist(InpSLPips),StopsDist()+spread);
   double tpDist=PipDist(InpTPPips);
   double lots=CalcLots();
   if(!MarginOK(dir,lots)){ g_note="not enough free margin"; return false; }

   double est=(dir>0)?Sym.Ask():Sym.Bid();
   double fill; ulong tk;
   if(!SendMarket(dir,lots,SafeSL(dir,est-dir*slDist),Nrm(est+dir*tpDist),fill,tk,"pyr1")) return false;

   if(tk==0 || !PositionSelectByTicket(tk)){ if(FindMine()) tk=Pos.Ticket(); }
   if(tk==0){ LG("ERROR","position opened but ticket not found"); return false; }

   // align SL / TP exactly to the real fill price (also attaches them if the broker refused them on entry)
   double wantSL=SafeSL(dir,fill-dir*slDist),wantTP=Nrm(fill+dir*tpDist);
   if(PositionSelectByTicket(tk))
     {
      double cs=PositionGetDouble(POSITION_SL),ct=PositionGetDouble(POSITION_TP);
      if(cs<=0||ct<=0||MathAbs(cs-wantSL)>_Point||MathAbs(ct-wantTP)>_Point)
         if(!Trade.PositionModify(tk,wantSL,wantTP)) LG("WARN",StringFormat("could not set SL/TP on #%I64u: %s",tk,Trade.ResultRetcodeDescription()));
     }

   g_ticket=tk; g_dir=dir; g_barsHeld=0; g_trailStage=-1; g_dayTrades++;
   LG("OPEN",StringFormat("%s %.2f @ %s SL %s TP %s (bal %.2f)",DirStr(dir),lots,DoubleToString(fill,_Digits),
        DoubleToString(wantSL,_Digits),DoubleToString(wantTP,_Digits),Bal()));
   QueueOpen(tk);
   return true;
  }

//+------------------------------------------------------------------+
//| Staged trailing SL                                               |
//|   prog = dir*(price-entry)/tpDist                                |
//|   highest stage whose trigger <= prog decides the SL:            |
//|   SL = entry + dir*lock*tpDist     (only ever moves forward)     |
//+------------------------------------------------------------------+
void ApplyTrail()
  {
   if(!InpUseTrail || !FindMine()) return;
   int dir=(Pos.PositionType()==POSITION_TYPE_BUY)?1:-1;
   double entry=Pos.PriceOpen(),sl=Pos.StopLoss(),tp=Pos.TakeProfit();
   double tpDist=PipDist(InpTPPips);
   if(tpDist<=0) return;
   Sym.RefreshRates();
   double px=(dir>0)?Sym.Bid():Sym.Ask();
   double prog=dir*(px-entry)/tpDist;

   int stage=-1;
   for(int k=0;k<5;k++) if(prog>=g_trTrig[k]-1e-9) stage=k;
   if(stage<0) return;

   double lvl=Nrm(entry+dir*g_trLock[stage]*tpDist);
   if(sl>0 && dir*(lvl-sl)<=_Point) { if(stage>g_trailStage) g_trailStage=stage; return; }   // never loosen / no change
   double md=StopsDist();
   bool placeable=(dir>0)?(lvl<=Sym.Bid()-md):(lvl>=Sym.Ask()+md);
   if(!placeable) return;
   if(Trade.PositionModify(Pos.Ticket(),lvl,tp))
     {
      if(stage>g_trailStage) g_trailStage=stage;
      LG("TRAIL",StringFormat("#%I64u reached %.0f%% of TP -> SL to %.0f%% of TP (%s)",Pos.Ticket(),g_trTrig[stage]*100,g_trLock[stage]*100,DoubleToString(lvl,_Digits)));
     }
  }

//+------------------------------------------------------------------+
//| Gates / entries / management                                     |
//+------------------------------------------------------------------+
bool Gates(string &why)
  {
   datetime now=TimeCurrent();
   if(DayStart(now)!=g_day){ g_day=DayStart(now); g_dayStartBalance=Bal(); g_dayPnL=0; g_dayTrades=0; g_dayStopped=false; }
   if(g_dayStopped){ why="day stopped"; return false; }
   if(InpMaxDailyLossPct>0 && g_dayStartBalance>0 && g_dayPnL<=-g_dayStartBalance*InpMaxDailyLossPct/100.0){ g_dayStopped=true; why="daily loss limit"; return false; }
   if(InpDailyProfitLock>0 && g_dayPnL>=g_dayStartBalance*InpDailyProfitLock/100.0){ g_dayStopped=true; why="daily profit locked"; return false; }
   if(InpMaxTradesPerDay>0 && g_dayTrades>=InpMaxTradesPerDay){ why="max trades today"; return false; }
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)||!MQLInfoInteger(MQL_TRADE_ALLOWED)){ why="AutoTrading off"; return false; }
   if(SymbolInfoInteger(_Symbol,SYMBOL_TRADE_MODE)!=SYMBOL_TRADE_MODE_FULL){ why="market closed / restricted"; return false; }
   if(InpMaxSpreadATR>0 && atr>0)
     { Sym.RefreshRates(); if(Sym.Ask()-Sym.Bid()>InpMaxSpreadATR*atr){ why="spread too wide"; return false; } }
   return true;
  }

bool OpenCampaign(int dir)
  {
   string why;
   if(!Gates(why)){ g_note=why; g_blocked=true; return false; }
   g_blocked=false;
   return OpenTrade(dir);
  }

void TryEntry()
  {
   if(g_ticket!=0 || FindMine()) return;                 // one position at a time
   if(InpReentryCooldownSec>0 && (TimeCurrent()-g_lastExitTime)<InpReentryCooldownSec){ g_note="re-entry cooldown"; return; }
   int d=EntryDirection(false);
   if(d==0){ if(g_confDir==0) g_note="no direction yet"; return; }
   g_note="entering "+DirStr(d);
   OpenCampaign(d);
  }

void ManageTrade()
  {
   if(!FindMine()) return;
   int dir=(Pos.PositionType()==POSITION_TYPE_BUY)?1:-1;
   g_dir=dir;
   if(g_ticket==0) g_ticket=Pos.Ticket();

   // flip with the market - stop and reverse on the same tick
   if(InpFlipOnReverse && g_confDir!=0 && g_confDir!=dir)
     {
      int nd=g_confDir;
      LG("FLIP",StringFormat("%s -> %s, closing position",DirStr(dir),DirStr(nd)));
      Trade.PositionClose(Pos.Ticket(),InpDeviationPoints);
      CheckClosed();                                      // parks the old ticket for the close report
      if(InpStopAndReverse && !FindMine())
        {
         int d=EntryDirection(true);
         if(d==nd){ g_note="reversed to "+DirStr(nd); OpenCampaign(nd); }
        }
     }
  }

void OnNewBar()
  {
   if(FindMine())
     {
      g_barsHeld++;
      if(InpMaxHoldBars>0 && g_barsHeld>=InpMaxHoldBars && Pos.Profit()<0)
        { LG("EXIT","time exit"); Trade.PositionClose(Pos.Ticket(),InpDeviationPoints); CheckClosed(); }
      return;
     }
   if(!InpIntrabarEntry) TryEntry();
  }

// resume after a restart / recompile with the position still open
void RecoverState()
  {
   if(!FindMine()) return;
   g_ticket=Pos.Ticket();
   g_dir=(Pos.PositionType()==POSITION_TYPE_BUY)?1:-1;
   LG("RECOVER",StringFormat("resumed %s #%I64u %.2f lots",DirStr(g_dir),g_ticket,Pos.Volume()));
  }

