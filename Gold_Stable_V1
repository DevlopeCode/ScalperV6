input ENUM_TIMEFRAMES   InpTF               = PERIOD_M1;   // bar TF: ATR, hold timer
input ENUM_TIMEFRAMES   InpTrendTF          = PERIOD_M1;   // direction timeframe
input int               InpTrendFast        = 5;           // fast EMA
input int               InpTrendSlow        = 20;          // slow EMA
input bool              InpUseFormingBar    = true;        // true = read EMAs on forming bar (intrabar flips)
