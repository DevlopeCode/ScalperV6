int OnInit()
  {
   Sym.Name(_Symbol);
   Trade.SetExpertMagicNumber(InpMagic); Trade.SetDeviationInPoints(InpDeviationPoints); Trade.LogLevel(LOG_LEVEL_ERRORS);
   hATR=iATR(_Symbol,InpTF,InpATRPeriod);
   hTrF=iMA(_Symbol,InpTrendTF,InpTrendFast,0,MODE_EMA,PRICE_CLOSE);
   hTrS=iMA(_Symbol,InpTrendTF,InpTrendSlow,0,MODE_EMA,PRICE_CLOSE);
   if(InpTrendFilter!=TFILT_OFF && InpEMATrend>0) hTr200=iMA(_Symbol,InpTrendTF,InpEMATrend,0,MODE_EMA,PRICE_CLOSE);
   if(hATR==INVALID_HANDLE||hTrF==INVALID_HANDLE||hTrS==INVALID_HANDLE){ LG("ERROR","indicator handle failed"); return INIT_FAILED; }
   if(InpTrendFast>=InpTrendSlow){ LG("ERROR","InpTrendFast must be < InpTrendSlow"); return INIT_PARAMETERS_INCORRECT; }
   if(InpTPPips<=0||InpSLPips<=0||InpPointsPerPip<=0){ LG("ERROR","SL/TP pips and points-per-pip must be > 0"); return INIT_PARAMETERS_INCORRECT; }
   if(InpBalancePerStep<=0||InpLotPerStep<=0||InpTesterLot<=0){ LG("ERROR","lot inputs must be > 0"); return INIT_PARAMETERS_INCORRECT; }

   // trail table
   double tr[5]={InpTrail1Trigger,InpTrail2Trigger,InpTrail3Trigger,InpTrail4Trigger,InpTrail5Trigger};
   double lk[5]={InpTrail1Lock,InpTrail2Lock,InpTrail3Lock,InpTrail4Lock,InpTrail5Lock};
   for(int k=0;k<5;k++)
     {
      g_trTrig[k]=tr[k]/100.0; g_trLock[k]=lk[k]/100.0;
      if(tr[k]<=0||tr[k]>=100||lk[k]<0||lk[k]>=tr[k]||(k>0 && (tr[k]<=tr[k-1]||lk[k]<lk[k-1])))
        { LG("ERROR",StringFormat("trail stage %d invalid: triggers must increase, locks must not decrease and stay below their trigger",k+1)); return INIT_PARAMETERS_INCORRECT; }
     }

   g_day=DayStart(TimeCurrent()); g_dayStartBalance=Bal();
   atr=Buf(hATR,1);
   RecoverState();

   LG("INFO",StringFormat("v5.00 on %s | bal %.2f | SL %.0f / TP %.0f pips (%.2f / %.2f price) | lot now %.2f (%s) | TRAIL %s",
        _Symbol,Bal(),InpSLPips,InpTPPips,PipDist(InpSLPips),PipDist(InpTPPips),CalcLots(),(InTester()||InpFixedLotEverywhere)?"fixed":"balance-based",InpUseTrail?"ON":"OFF"));
   LG("INFO",StringFormat("TRAIL: 20%%->1%% | 50%%->20%% | 70%%->50%% | 80%%->60%% | 90%%->80%% (inputs: %.0f>%.0f %.0f>%.0f %.0f>%.0f %.0f>%.0f %.0f>%.0f)",
        tr[0],lk[0],tr[1],lk[1],tr[2],lk[2],tr[3],lk[3],tr[4],lk[4]));
   if(SheetOn())
     {
      hR_E9 =iMA(_Symbol,InpRptTF,RPT_EMA_FAST,0,MODE_EMA,PRICE_CLOSE);
      hR_E20=iMA(_Symbol,InpRptTF,RPT_EMA_SLOW,0,MODE_EMA,PRICE_CLOSE);
      hR_S9 =iMA(_Symbol,InpRptTF,RPT_SMA,0,MODE_SMA,PRICE_CLOSE);
      hR_ADX=iADX(_Symbol,InpRptTF,InpRptADXPeriod);
      hR_ATR=iATR(_Symbol,InpRptTF,InpRptATRPeriod);
      hR_BB =iBands(_Symbol,InpRptTF,InpRptBBPeriod,0,InpRptBBDev,PRICE_CLOSE);
      if(hR_E9==INVALID_HANDLE||hR_E20==INVALID_HANDLE||hR_S9==INVALID_HANDLE||hR_ADX==INVALID_HANDLE||hR_ATR==INVALID_HANDLE||hR_BB==INVALID_HANDLE)
         LG("WARN","report indicator handle failed - indicator columns will be 0");
     }
   if(!InTester() && InpSheetEnabled)
     {
      if(StringLen(InpSheetURL)<=10) LG("WARN","Google Sheet reporting is ON but InpSheetURL is empty - nothing will be sent");
      else LG("INFO","Google Sheet reporting ON. Make sure the URL is listed in Tools > Options > Expert Advisors > Allow WebRequest for listed URL (add https://script.google.com and https://script.googleusercontent.com)");
     }
   EventSetTimer(1);
   return INIT_SUCCEEDED;
  }

void OnDeinit(const int reason)
  {
   EventKillTimer();
   if(hATR!=INVALID_HANDLE) IndicatorRelease(hATR);
   if(hTrF!=INVALID_HANDLE) IndicatorRelease(hTrF);
   if(hTrS!=INVALID_HANDLE) IndicatorRelease(hTrS);
   if(hTr200!=INVALID_HANDLE) IndicatorRelease(hTr200);
   int rh[6]={hR_E9,hR_E20,hR_S9,hR_ADX,hR_ATR,hR_BB};
   for(int k=0;k<6;k++) if(rh[k]!=INVALID_HANDLE) IndicatorRelease(rh[k]);
   if(reason!=REASON_CHARTCHANGE && reason!=REASON_PARAMETERS) ObjectsDeleteAll(0,"PYR_");
  }

void OnTick()
  {
   atr=Buf(hATR,1);
   if(atr<=0) return;
   UpdateDirection();                          // every tick
   CheckClosed();                              // SL / TP / manual close detection
   ProcessPending();                           // close reports waiting for deal history
   if(FindMine()){ ApplyTrail(); ManageTrade(); }
   else if(InpIntrabarEntry) TryEntry();
   datetime bt=iTime(_Symbol,InpTF,0);
   if(bt!=g_lastBar && bt!=0){ g_lastBar=bt; OnNewBar(); if(InTester()) Dashboard(); }
  }

void OnTimer()
  {
   if(InTester()) return;
   CheckClosed();                              // also catches closes while no ticks arrive
   ProcessPending();
   FlushQueue();
   Dashboard();
  }

double OnTester()
  {
   int cl=g_nWins+g_nLosses;
   Print(StringFormat("===== v5.00: %d trades  win %.1f%%  PF %.2f  net %.2f  flips %d =====",
        cl,cl>0?100.0*g_nWins/cl:0,g_grossLoss>0?g_grossWin/g_grossLoss:0,g_grossWin-g_grossLoss,g_flips));
   double pf=TesterStatistics(STAT_PROFIT_FACTOR),tr=TesterStatistics(STAT_TRADES),dd=TesterStatistics(STAT_EQUITY_DDREL_PERCENT);
   if(tr<30) return 0;
   return MathMin(pf,3.0)*MathSqrt(MathMin(tr,300.0))-dd/5.0;
  }
