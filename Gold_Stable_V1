void Lbl(string id,int x,int y,string txt,color clr)
  {
   string n="PYR_L_"+id;
   if(ObjectFind(0,n)<0)
     { ObjectCreate(0,n,OBJ_LABEL,0,0,0); ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER); ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false); ObjectSetString(0,n,OBJPROP_FONT,"Consolas"); }
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x); ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetString(0,n,OBJPROP_TEXT,txt); ObjectSetInteger(0,n,OBJPROP_COLOR,clr); ObjectSetInteger(0,n,OBJPROP_FONTSIZE,InpFontSize);
  }
void Dashboard()
  {
   if(!InpShowDashboard) return;
   int lh=InpFontSize+6,x=12,y=24,i=0; color cH=clrWhite,cM=clrSilver,cG=clrLimeGreen,cR=clrTomato,cY=clrGold;
   string n="PYR_PANEL";
   if(ObjectFind(0,n)<0)
     { ObjectCreate(0,n,OBJ_RECTANGLE_LABEL,0,0,0); ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER); ObjectSetInteger(0,n,OBJPROP_BGCOLOR,C'16,20,28'); ObjectSetInteger(0,n,OBJPROP_BORDER_TYPE,BORDER_FLAT); ObjectSetInteger(0,n,OBJPROP_COLOR,clrDimGray); ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false); }
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,6); ObjectSetInteger(0,n,OBJPROP_YDISTANCE,18); ObjectSetInteger(0,n,OBJPROP_XSIZE,470); ObjectSetInteger(0,n,OBJPROP_YSIZE,lh*9+12);
   double bal=Bal();
   Lbl("a",x,y+lh*i++,StringFormat("  %s SINGLE POSITION v5.00  SL %.0f / TP %.0f pips  24/7",_Symbol,InpSLPips,InpTPPips),cH);
   Lbl("b",x,y+lh*i++,"---------------------------------------------------",cM);
   Lbl("c",x,y+lh*i++,StringFormat("Bal %.2f | next lot %.2f (%s) | sheet %s q%d",bal,CalcLots(),(InTester()||InpFixedLotEverywhere)?"fixed":"balance-based",SheetOn()?"ON":"off",ArraySize(g_q)),cM);
   Lbl("d",x,y+lh*i++,StringFormat("TREND %s  raw %s  gap %.2f band %.2f  flips %d",DirStr(g_confDir),DirStr(g_rawDir),g_fast-g_slow,InpFlipBandATR*atr,g_flips),g_confDir>0?cG:(g_confDir<0?cR:cY));
   if(FindMine())
     {
      double p=Pos.Profit()+Pos.Swap()+Pos.Commission(); double tpD=PipDist(InpTPPips);
      Sym.RefreshRates(); double px=(g_dir>0)?Sym.Bid():Sym.Ask();
      double prog=(tpD>0)?g_dir*(px-Pos.PriceOpen())/tpD*100.0:0;
      Lbl("e",x,y+lh*i++,StringFormat("IN %s %.2f lots  P/L %.2f  @ %.0f%% of TP",g_dir>0?"LONG":"SHORT",Pos.Volume(),p,prog),p>=0?cG:cR);
      Lbl("f",x,y+lh*i++,StringFormat("entry %s  SL %s  TP %s  trail stage %d/5",DoubleToString(Pos.PriceOpen(),_Digits),DoubleToString(Pos.StopLoss(),_Digits),DoubleToString(Pos.TakeProfit(),_Digits),g_trailStage+1),cM);
     }
   else
     {
      Lbl("e",x,y+lh*i++,"FLAT",cM);
      Lbl("f",x,y+lh*i++,"-",cM);
     }
   Lbl("g",x,y+lh*i++,StringFormat("Day %+.2f  trades %d %s",g_dayPnL,g_dayTrades,g_dayStopped?"STOPPED":""),g_dayPnL>=0?cG:cR);
   int cl=g_nWins+g_nLosses;
   Lbl("h",x,y+lh*i++,StringFormat("Session %d trades  win %.0f%%  PF %.2f",cl,cl>0?100.0*g_nWins/cl:0,g_grossLoss>0?g_grossWin/g_grossLoss:0),cH);
   Lbl("i",x,y+lh*i++,(g_blocked?"BLOCKED: ":"Note: ")+g_note,g_blocked?cR:cY);
   ChartRedraw(0);
  }

